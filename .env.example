# Copy to .env, fill in, then: set -a; source .env; set +a
# Gemini key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Milvus (local standalone default; on GKE use http://milvus.milvus.svc.cluster.local:19530)
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=papers_rag
# Translator microservice (uvicorn translator:app --port 8080)
TRANSLATOR_URL=http://127.0.0.1:8080
